{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev & yarn next-video sync -w",
    "dev:sections": "concurrently \"next dev\" \"watch 'yarn generate-section-schemas' ./src/sections \"",
    "generate-sitemap": "node src/scripts/generate-sitemap.js",
    "prebuild": "yarn generate-sitemap",
    "build": "yarn test && next build",
    "start": "next start",
    "lint": "next lint",
    "ts-lint": "tsc --noEmit --incremental --watch",
    "ts-lint-commit-hook": "tsc --noEmit --incremental",
    "generate-section-schemas": "node src/scripts/generate-section-schemas",
    "prepare": "husky install",
    "postinstall": "patch-package",
    "test": "NODE_ENV=test jest"
  },
  "dependencies": {
    "@accessible/drawer": "^3.0.2",
    "@notionhq/client": "^2.2.14",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-popover": "1.0.7",
    "@radix-ui/react-select": "^1.2.2",
    "@supabase/supabase-js": "^2.21.0",
    "@szhsin/react-menu": "^4.1.0",
    "@types/lodash.throttle": "4.1.9",
    "@types/node": "^18.11.15",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "@types/react-modal": "^3.13.1",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.1",
    "@vercel/analytics": "^1.0.2",
    "@vercel/speed-insights": "^1.1.0",
    "concurrently": "8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "formidable": "^3.5.4",
    "fuse.js": "^6.6.2",
    "lodash.throttle": "^4.1.1",
    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "next-video": "2.8.1",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^2.5.1",
    "qrcode.react": "^4.1.0",
    "radash": "^11.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-ga4": "^2.1.0",
    "react-google-recaptcha": "^3.1.0",
    "react-icons": "^4.10.1",
    "react-is": "^18.2.0",
    "react-modal": "^3.16.1",
    "react-paginate": "^8.2.0",
    "react-responsive-carousel": "^3.2.23",
    "react-tabs": "^6.0.2",
    "recoil": "0.7.7",
    "resend": "^6.12.4",
    "rss-parser": "^3.13.0",
    "styled-components": "^5.3.6",
    "styled-system": "^5.1.5",
    "typescript": "^6.0.2",
    "typescript-json-schema": "^0.59.0",
    "watch": "^1.0.2"
  },
  "resolutions": {
    "@aws-sdk/xml-builder": "3.972.6",
    "@babel/core": "^7.27.4",
    "@babel/traverse": "^7.23.2",
    "fast-xml-parser": "5.3.6",
    "styled-components": "^5",
    "tmp": "^0.2.4",
    "**/undici": "^7.24.6",
    "**/picomatch": "^2.3.2"
  },
  "devDependencies": {
    "@testing-library/react": "^14",
    "@types/formidable": "^3.4.5",
    "@types/jest": "^30.0.0",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/styled-components": "5.1.30",
    "@types/styled-system": "5.1.22",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "8.0.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^13.1.0",
    "node-mocks-http": "^1.17.2",
    "ts-jest": "^29.4.11"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/src/jest.setup.ts"
    ],
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "moduleNameMapper": {
      "\\.(css|less|sass|scss)$": "<rootDir>/src/__mocks__/styleMock.js",
      "^lib/(.*)$": "<rootDir>/src/lib/$1",
      "^pages/(.*)$": "<rootDir>/src/pages/$1",
      "^components/(.*)$": "<rootDir>/src/components/$1",
      "^modules/(.*)$": "<rootDir>/src/modules/$1",
      "^context/(.*)$": "<rootDir>/src/context/$1",
      "^types/(.*)$": "<rootDir>/src/types/$1",
      "^theme$": "<rootDir>/src/theme/index.ts",
      "^theme/(.*)$": "<rootDir>/src/theme/$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react-jsx"
          }
        }
      ]
    }
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
